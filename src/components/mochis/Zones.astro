---
const zones = ["Los Mochis", "Culiacan", "Mazatlán", "Guasave", "Guamúchil", "Navolato", "El Fuerte", "Ahome", "Todo Sinaloa →"];
---

<section class="bg-white py-24 sm:py-28" aria-labelledby="zones-title">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:px-12">
    <div><p class="text-sm font-black uppercase tracking-[.2em] text-brand">Dónde trabajamos</p><h2 id="zones-title" class="mt-4 text-balance text-4xl font-black leading-tight tracking-[-.04em] text-ink sm:text-5xl">Diseño web para todo el norte de Sinaloa.</h2><p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">Atendemos a negocios en Los Mochis y municipios cercanos. Todo el trabajo es remoto y sin costo de traslado.</p></div>
    <div class="relative rounded-[1.75rem] border border-brand/15 bg-brand/5 p-6 sm:p-9">
      <div class="pointer-events-none absolute right-6 top-6 size-28 rounded-full bg-brand/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative flex flex-wrap gap-3">
        {zones.map((zone, index) => (
          <span class:list={["inline-flex min-h-12 items-center gap-2 rounded-full border px-5 py-3 text-sm font-bold", index === 0 ? "border-brand bg-brand text-white shadow-[0_4px_0_#253b9c]" : "border-slate-200 bg-white text-ink"]}>
            {index === 0 && <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-5.6 7-12a7 7 0 1 0-14 0c0 6.4 7 12 7 12Z" /><circle cx="12" cy="9" r="2.5" /></svg>}
            {zone}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
