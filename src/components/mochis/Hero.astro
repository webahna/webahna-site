---
import "../../styles/mochis/hero.css";
---

<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="hero-glow"></div>

  <div class="hero-content">
    <div class="local-eyebrow">📍 Los Mochis, Sinaloa</div>

    <h1>
      Diseño web<br />
      para negocios<br />
      <em>en Los Mochis</em>
    </h1>

    <p class="hero-desc">
      Tu competencia ya está en Google. Creamos páginas web profesionales para
      negocios locales en Los Mochis y todo Sinaloa — con SEO incluido desde el
      primer día.
    </p>

    <div class="hero-actions">
      <a href="#contacto" class="btn-primary">Quiero mi página web →</a>
      <a href="https://wa.me/526682348809" class="btn-ghost">💬 WhatsApp</a>
    </div>
  </div>

  <div class="hero-visual">
    <div class="map-card">
      <div class="map-header">
        <div class="map-dot" style="background:#EF4444;"></div>
        <div class="map-dot" style="background:#F59E0B;"></div>
        <div class="map-dot" style="background:#10B981;"></div>
        <span style="font-size:0.78rem; color:var(--gray-600); margin-left:8px;"
          >webahna.com — Los Mochis, Sin.</span
        >
      </div>

      <div class="map-area">
        <!-- Mapa estilizado de Sinaloa -->
        <svg
          class="map-svg"
          viewBox="0 0 440 260"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Silueta costa/estado simplificada -->

          <path
            fill="#131d2e"
            stroke="#1e2d45"
            stroke-width="1"
            d="M301.86,210.09c-3.78,8.62-7.41,13.39-2.64,22.85-3.24.49-6.37-1.04-8.74-3.12-18.55-16.28-30.72-37.96-47.09-55.81-5.76-6.28-17.53-13.84-21.57-19.77-2.18-3.21-1.96-7.74-3.98-10.09-4.31-5.01-15.23-.19-18.63-11.28-3.1-10.1,1.92-12.79-9.34-19.69-6.74-4.13-27.71-12.58-28.55-21.61-.23-2.46,2.87-6.32.74-7.75-4.84-3.25-7.66,9.81-10.93,9.22-5.43-6-14-6.24-12.89-16.23.86-7.77,7.9-7.79,11.92-10.95,2.37-1.87,4.46-7.85,6.98-10.61,4.07-4.46,11.96-8.54,15.89-13.13,2.28-2.66,6.84-14.43,7.55-14.87,1.11-.7,2.84.07,3.9.72,4.07,2.47,14.91,16.9,16.17,21.64,1.17,4.36.88,15,3.52,17.59,2.48,2.44,10.22,1.78,14.95,5.28s5.19,8.28,8.37,11.86c2.67,3,9.01,4.38,8.25,8.97-.96,5.84-5.1,11.05-5.2,18.68-.22,17.26,10.69,18.72,18.04,29.53,2.77,4.08,3.01,10.53,6.69,13.54,7.55,6.18,11.42-2.96,16.2-2.22,2.68.41,7.47,12.35,8.4,15.43,2.14,7.13,1.57,13.53,5.41,20.1,3.31,5.66,3.35,7.42,5.84,12.63,1.75,3.67,6.72,8.18,10.73,9.07Z"
          ></path>

          <!-- Label Sinaloa -->
          <text
            x="300"
            y="110"
            fill="#2d3a52"
            font-size="16"
            font-family="sans-serif"
            font-weight="600">Sinaloa</text
          >
          <!-- Puntos ciudades -->
          <circle cx="205" cy="120" r="3" fill="#2d3a52"></circle>
          <text
            x="215"
            y="124"
            fill="#2d3a52"
            font-size="12"
            font-family="sans-serif">Culiacan</text
          >
          <circle cx="245" cy="168" r="3" fill="#2d3a52"></circle>
          <text
            x="258"
            y="172"
            fill="#2d3a52"
            font-size="12"
            font-family="sans-serif">Mazatlán</text
          >
        </svg>

        <!-- Pin flotante Los Mochis -->
        <div class="location-pin">
          <div class="pin-bubble">📍 Los Mochis</div>
          <div class="pin-dot"></div>
        </div>
      </div>

      <div class="map-stats">
        <div class="map-stat">
          <strong>+20</strong>
          <span>Proyectos entregados</span>
        </div>
        <div class="map-stat">
          <strong>48h</strong>
          <span>Respuesta inicial</span>
        </div>
      </div>
    </div>
  </div>
</section>
