---
const audiences = [
  { title: "Tiendas y Comercios", text: "Muestra tu catálogo, horarios y ubicación. Que te encuentren antes que a tu competencia.", icon: "M4 20V8l8-4 8 4v12M8 20v-6h8v6M3 8h18" },
  { title: "Restaurantes y Cafés", text: "Menú en línea, galería de platillos y reservas. Llena más mesas con presencia digital.", icon: "M5 4v7a3 3 0 0 0 3 3V4M5 8h3M8 14v6M16 4v16M16 4c3 2 3 7 0 9" },
  { title: "Consultorios y Clínicas", text: "Genera confianza con una web profesional y permite agendar citas en línea fácilmente.", icon: "M9 4h6v5h5v6h-5v5H9v-5H4V9h5V4Z" },
  { title: "Constructoras y Servicios", text: "Muestra tus proyectos, testimonios y formas de contacto para cerrar más contratos.", icon: "M4 20V9l8-5 8 5v11M8 20v-5h8v5M8 10h.01M12 10h.01M16 10h.01" },
  { title: "Despachos y Profesionistas", text: "Abogados, contadores, arquitectos — una web seria que refleje tu nivel profesional.", icon: "M4 20h16M6 20V8h12v12M9 8V4h6v4M9 12h2M13 12h2M9 16h2M13 16h2" },
  { title: "Emprendedores Digitales", text: "Vende en línea desde Los Mochis al resto de México. Tu tienda online siempre abierta.", icon: "M4 7h16l-1 13H5L4 7Zm4 0a4 4 0 0 1 8 0" },
];
---

<section class="bg-white py-24 sm:py-28" aria-labelledby="audience-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="grid gap-7 lg:grid-cols-[.75fr_1.25fr] lg:items-end">
      <div>
        <p class="text-sm font-black uppercase tracking-[.2em] text-brand">Para quién es</p>
        <h2 id="audience-title" class="mt-4 max-w-3xl text-balance text-4xl font-black leading-tight tracking-[-.04em] text-ink sm:text-5xl">Negocios locales que quieren crecer en internet.</h2>
      </div>
      <p class="max-w-2xl text-lg leading-8 text-slate-600 lg:justify-self-end">Si tienes un negocio en Los Mochis y no tienes página web — o tienes una que no funciona —, esto es para ti.</p>
    </div>
    <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {audiences.map((item, index) => (
        <article class="group rounded-3xl border border-slate-200 bg-[#f8f9fd] p-7 transition hover:-translate-y-1 hover:border-brand/30 hover:bg-white hover:shadow-xl hover:shadow-brand/10 motion-reduce:transform-none">
          <div class="flex items-start justify-between gap-5"><span class="grid size-12 place-items-center rounded-2xl bg-brand text-white shadow-[0_4px_0_#253b9c]"><svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg></span><span class="text-xs font-black tracking-[.15em] text-slate-300">0{index + 1}</span></div>
          <h3 class="mt-7 text-xl font-extrabold tracking-tight text-ink">{item.title}</h3>
          <p class="mt-3 leading-7 text-slate-600">{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
