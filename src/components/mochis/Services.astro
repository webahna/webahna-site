---
const services = [
  ["Páginas Web Profesionales", "Sitios rápidos, modernos y optimizados para Google. Desde landing pages hasta portales multi-sección completos.", "HTML · React · WordPress"],
  ["SEO Local en Los Mochis", "Posicionamiento en Google Maps, fichas de negocio optimizadas y estrategia de palabras clave para tu ciudad.", "Google My Business · Schema"],
  ["Tiendas en Línea", "Vende tus productos en internet con catálogo, carrito y pagos en línea. Gestión sencilla desde tu celular.", "Shopify · WooCommerce"],
  ["Diseño de Identidad Visual", "Logo, paleta de colores y materiales digitales para que tu marca se vea profesional en todos lados.", "Figma · Branding"],
  ["Mantenimiento Mensual", "Actualizaciones, seguridad, respaldos y mejoras continuas. Tu web siempre funcionando al 100%.", "Soporte · Hosting"],
  ["Google Ads Local", "Campañas de publicidad pagada dirigidas exactamente a personas buscando tu servicio en Los Mochis.", "Google Ads · Analytics"],
];
---

<section id="servicios" class="bg-[#f7f8fc] py-24 sm:py-28" aria-labelledby="services-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="max-w-3xl"><p class="text-sm font-black uppercase tracking-[.2em] text-brand">Qué hacemos</p><h2 id="services-title" class="mt-4 text-balance text-4xl font-black leading-tight tracking-[-.04em] text-ink sm:text-5xl">Servicios de diseño web en Los Mochis.</h2><p class="mt-5 text-lg leading-8 text-slate-600">Todo lo que necesitas para tener presencia digital profesional — sin enredos técnicos.</p></div>
    <div class="mt-14 grid gap-px overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-200 shadow-xl shadow-slate-900/5 md:grid-cols-2 lg:grid-cols-3">
      {services.map(([title, text, tags], index) => (
        <article class="group min-h-72 bg-white p-7 sm:p-8">
          <div class="flex items-center justify-between"><span class="text-sm font-black tracking-[.15em] text-brand">0{index + 1}</span><svg class="size-5 text-slate-300 transition group-hover:translate-x-1 group-hover:text-brand motion-reduce:transform-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-5-5 5 5-5 5" /></svg></div>
          <h3 class="mt-9 text-2xl font-extrabold tracking-tight text-ink">{title}</h3><p class="mt-4 leading-7 text-slate-600">{text}</p><p class="mt-7 text-xs font-black uppercase tracking-[.12em] text-brand">{tags}</p>
        </article>
      ))}
    </div>
  </div>
</section>
