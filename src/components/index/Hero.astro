<section class="relative isolate overflow-hidden bg-white pt-32 sm:pt-36 lg:pt-40">
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-20 opacity-70 [background-image:linear-gradient(to_right,#e6e9f2_1px,transparent_1px),linear-gradient(to_bottom,#e6e9f2_1px,transparent_1px)] [background-size:48px_48px] [mask-image:linear-gradient(to_bottom,black,transparent_82%)]"
  ></div>
  <div
    aria-hidden="true"
    class="absolute -right-32 top-10 -z-10 size-[30rem] rounded-full bg-brand/10 blur-3xl lg:size-[42rem]"
  ></div>

  <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 pb-20 sm:px-8 sm:pb-24 lg:grid-cols-[1.02fr_.98fr] lg:px-10 lg:pb-28">
    <div data-reveal="left">
      <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-brand/20 bg-brand/5 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-brand-dark sm:text-sm">
        <span class="size-2 rounded-full bg-brand" aria-hidden="true"></span>
        Disponible para nuevos proyectos
      </div>

      <h1 class="max-w-3xl text-balance text-5xl font-bold leading-[0.98] tracking-[-0.055em] text-ink sm:text-6xl lg:text-7xl xl:text-[5.4rem]">
        Webs que convierten ideas en <span class="text-brand">negocios.</span>
      </h1>

      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
        Diseñamos y desarrollamos experiencias web a medida para atraer clientes,
        generar confianza y hacer crecer tu marca.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="#contacto"
          class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand px-6 font-bold text-white shadow-[0_7px_0_#263da5] transition-[transform,box-shadow,background-color] duration-200 hover:-translate-y-0.5 hover:bg-brand-dark hover:shadow-[0_9px_0_#1e3189] active:translate-y-1 active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-4"
        >
          Iniciar un proyecto
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" class="ml-2 size-5">
            <path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          href="#proyectos"
          class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-300 bg-white px-6 font-bold text-ink transition-colors duration-200 hover:border-ink hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-4"
        >
          Ver nuestro trabajo
        </a>
      </div>

      <dl class="mt-12 grid max-w-xl grid-cols-3 gap-4 border-t border-slate-200 pt-7">
        <div>
          <dt class="text-sm leading-5 text-slate-500">Proyectos entregados</dt>
          <dd class="order-first mb-1 text-3xl font-bold tracking-tight text-ink">+20</dd>
        </div>
        <div>
          <dt class="text-sm leading-5 text-slate-500">Clientes satisfechos</dt>
          <dd class="order-first mb-1 text-3xl font-bold tracking-tight text-ink">100%</dd>
        </div>
        <div>
          <dt class="text-sm leading-5 text-slate-500">Años creando</dt>
          <dd class="order-first mb-1 text-3xl font-bold tracking-tight text-ink">+4</dd>
        </div>
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-xl lg:max-w-none" aria-hidden="true" data-reveal="right" data-delay="220">
      <div class="absolute -left-5 -top-5 size-24 rounded-3xl bg-brand"></div>
      <div class="absolute -bottom-6 -right-5 h-32 w-40 rounded-3xl border-2 border-ink bg-[#dce3ff]"></div>
      <div class="relative overflow-hidden rounded-[2rem] border-2 border-ink bg-ink p-3 shadow-[14px_14px_0_#4665e8] sm:p-4">
        <div class="overflow-hidden rounded-[1.35rem] bg-white">
          <div class="flex items-center gap-2 border-b border-slate-200 px-5 py-4">
            <span class="size-2.5 rounded-full bg-[#ff6b6b]"></span>
            <span class="size-2.5 rounded-full bg-[#ffd166]"></span>
            <span class="size-2.5 rounded-full bg-[#62d2a2]"></span>
            <span class="ml-3 h-2.5 w-32 rounded-full bg-slate-100"></span>
          </div>
          <div class="grid min-h-[25rem] gap-5 p-5 sm:grid-cols-[1.2fr_.8fr] sm:p-7">
            <div class="flex flex-col justify-between rounded-2xl bg-brand p-6 text-white">
              <div>
                <span class="inline-flex rounded-full border border-white/30 px-3 py-1 text-xs font-semibold">Estrategia + diseño</span>
                <p class="mt-8 text-3xl font-bold leading-tight tracking-tight">Una presencia digital hecha para crecer.</p>
              </div>
              <div class="mt-8 h-11 w-36 rounded-xl bg-white"></div>
            </div>
            <div class="grid gap-5">
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <div class="flex items-end gap-2">
                  <span class="h-12 flex-1 rounded-t-md bg-brand/25"></span>
                  <span class="h-20 flex-1 rounded-t-md bg-brand/45"></span>
                  <span class="h-28 flex-1 rounded-t-md bg-brand"></span>
                  <span class="h-24 flex-1 rounded-t-md bg-ink"></span>
                </div>
                <p class="mt-4 text-sm font-bold text-ink">Resultados medibles</p>
              </div>
              <div class="rounded-2xl bg-[#f1f3f9] p-5">
                <div class="flex items-center gap-3">
                  <span class="grid size-11 place-items-center rounded-full bg-ink text-white">
                    <svg viewBox="0 0 24 24" fill="none" class="size-5">
                      <path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <div>
                    <span class="block h-2.5 w-24 rounded-full bg-slate-300"></span>
                    <span class="mt-2 block h-2 w-16 rounded-full bg-slate-200"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
