---
import webahnaLogo from "../../assets/logo.svg";
---

<nav
  aria-label="Navegación principal"
  class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 sm:px-8 lg:h-24 lg:px-10"
  >
    <a
      href="/"
      aria-label="Webahna, inicio"
      class="inline-flex min-h-12 items-center rounded-md outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-4"
    >
      <img
        src={webahnaLogo.src}
        width="176"
        height="40"
        alt="Webahna"
        class="h-8 w-auto sm:h-9"
      />
    </a>

    <ul class="hidden items-center gap-7 text-sm font-semibold text-slate-600 md:flex">
      <li><a class="transition-colors hover:text-ink focus-visible:text-ink" href="#servicios">Servicios</a></li>
      <li><a class="transition-colors hover:text-ink focus-visible:text-ink" href="#proceso">Proceso</a></li>
      <li><a class="transition-colors hover:text-ink focus-visible:text-ink" href="#proyectos">Proyectos</a></li>
      <li><a class="transition-colors hover:text-ink focus-visible:text-ink" href="#precios">Precios</a></li>
    </ul>

    <a
      href="#contacto"
      class="inline-flex min-h-11 items-center justify-center rounded-xl bg-brand px-4 text-sm font-bold text-white shadow-[0_6px_0_#263da5] transition-[transform,box-shadow,background-color] duration-200 hover:-translate-y-0.5 hover:bg-brand-dark hover:shadow-[0_8px_0_#1e3189] active:translate-y-1 active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-4 sm:px-5"
    >
      Hablemos
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" class="ml-2 size-4">
        <path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</nav>
