---
const tools = [
  "Astro",
  "Next.js",
  "React",
  "TypeScript",
  "Node.js",
  "NestJS",
  "Prisma",
  "MySQL",
  "AWS",
  "Cloudflare",
  "Stripe",
  "Figma",
];
---

<section class="border-y border-slate-200 bg-[#f4f6fb] py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <div class="grid gap-8 lg:grid-cols-[.55fr_1.45fr] lg:items-center">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand">Stack tecnológico</p>
        <h2 class="mt-3 text-3xl font-bold tracking-[-0.035em] text-ink">La herramienta correcta para cada reto.</h2>
      </div>
      <ul class="flex flex-wrap gap-2.5 lg:justify-end" aria-label="Tecnologías que utilizamos">
        {tools.map((tool) => (
          <li class="rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm">
            {tool}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
